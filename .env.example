# =================================
# FoxSignals Listener Configuration
# =================================

# ============ AUTHENTICATION ============
# Choose ONE of these options:

# Option 1: JWT Token (for Google Login users)
# Get this from your FoxSignals app/browser
FOXSIGNALS_ID_TOKEN=your-jwt-token-here
FOXSIGNALS_REFRESH_TOKEN=your-refresh-token-here

# Option 2: Email/Password (for Email Login users)
# FOXSIGNALS_EMAIL=your@email.com
# FOXSIGNALS_PASSWORD=your-password

# ============ WEBHOOK ============
# Your Bot's Webhook URL (REQUIRED)
BOT_WEBHOOK_URL=https://your-bot.com/webhook

# Optional: Secret for authenticating with your bot
WEBHOOK_SECRET=

# ============ POLLING ============
# Polling interval in milliseconds (default: 10000 = 10 seconds)
# Only used with JWT Token mode
POLL_INTERVAL=10000

# ============ SERVER ============
PORT=3000

# ============ RETRY ============
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
