# Server Configuration
PORT=3000

# Your Bot's Webhook URL - REQUIRED
# This is where signals will be forwarded to
BOT_WEBHOOK_URL=https://your-bot-webhook-url.com/signal

# Optional: Secret for authenticating with your bot
WEBHOOK_SECRET=your-secret-key

# Optional: Secret expected from FoxSignals (for validation)
FOXSIGNALS_SECRET=

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
