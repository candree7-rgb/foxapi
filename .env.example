# =================================
# FoxSignals Listener Configuration
# =================================

# FoxSignals Login (REQUIRED)
# Your FoxSignals account credentials
FOXSIGNALS_EMAIL=your-foxsignals@email.com
FOXSIGNALS_PASSWORD=your-password

# Your Bot's Webhook URL (REQUIRED for forwarding)
# This is where signals will be sent to
BOT_WEBHOOK_URL=https://your-bot-webhook-url.com/signal

# Optional: Secret for authenticating with your bot
WEBHOOK_SECRET=your-secret-key

# Server Configuration
PORT=3000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
